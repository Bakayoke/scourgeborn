# Railway / server environment
#
# Stripe
# 1. Developers → API keys → Secret key (sk_test_… or sk_live_…)
# 2. Optional: Developers → Webhooks → endpoint
#    URL: https://<your-railway-service>.up.railway.app/api/stripe/webhook
#    Event: checkout.session.completed
# 3. Paste webhook signing secret (whsec_…)
#
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://scourgeborn.com
# Optional CORS (comma-separated).
# CORS_ORIGIN=https://scourgeborn.com,https://www.scourgeborn.com
#
# Optional: custom Price IDs. If empty, Checkout uses inline SEK amounts.
# STRIPE_PARTY_PRICE_ID=price_...
# STRIPE_PARTY_WEEK_PRICE_ID=price_...
# STRIPE_PARTY_AMOUNT_ORE=3900
# STRIPE_PARTY_WEEK_AMOUNT_ORE=9900
# First-time −30% coupon id (auto-created if missing):
# STRIPE_FIRST_PARTY_COUPON=scourgeborn_first30
#
# Promo codes (comma-separated). Empty = no redeemable codes.
# PARTY_PASS_CODES=MYCODE,OTHERCODE
#
# Persistence (Party passes + rooms across restarts) — REQUIRED in production
# Without this, rooms vanish on every Railway deploy/restart and joiners see
# "Hittade inget spel med den koden".
#
# 1. Railway → project → + New → Database → Redis
# 2. On the API service → Variables → Add variable reference REDIS_URL
# 3. Redeploy the API. Verify: GET /api/health → persist.configured: true
#
# REDIS_URL=redis://default:…@….railway.internal:6379
# Or mount a volume at /data (auto-detected) or set:
# SCOURGEBORN_DATA_DIR=/data
